generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum CheckInSource {
  QR
  FRONT_DESK
  MANUAL
  NFC
}

enum BookingStatus {
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum TrainerSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum NotificationType {
  CLASS_REMINDER
  SESSION_REMINDER
  MEMBERSHIP_UPDATE
  PROMOTION
  SYSTEM_ALERT
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  roles        UserRole[]
  subscriptions Subscription[]
  checkIns     CheckIn[]
  trainerProfile TrainerProfile?
  trainerSessions TrainerSession[] @relation("TrainerSessions")
  clientSessions  TrainerSession[] @relation("ClientSessions")
  workoutPlans    WorkoutPlan[]
  sessionNotes    SessionNote[]
  notifications   Notification[]
  auditLogs       AuditLog[] @relation("AuditActor")
  paymentLogs     PaymentLog[]
}

model Role {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     UserRole[]
}

model UserRole {
  id          String      @id @default(uuid())
  userId      String
  roleId      String
  locationId  String?
  assignedAt  DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id])
  role        Role        @relation(fields: [roleId], references: [id])
  location    Location?   @relation(fields: [locationId], references: [id])

  @@unique([userId, roleId, locationId])
}

model Location {
  id           String     @id @default(uuid())
  name         String
  address      String
  city         String
  state        String
  postalCode   String
  country      String
  timezone     String
  phone        String?
  amenities    Json
  openingHours Json
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  checkIns     CheckIn[]
  classes      Class[]
  subscriptions Subscription[]
  trainerLinks TrainerLocation[]
  adminRoles   UserRole[]
}

model MembershipPlan {
  id           String     @id @default(uuid())
  name         String
  description  String
  tier         String
  monthlyPrice Decimal
  accessRules  Json
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id               String            @id @default(uuid())
  userId           String
  membershipPlanId String
  homeLocationId   String
  status           MembershipStatus  @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime?
  autoRenew        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  plan             MembershipPlan    @relation(fields: [membershipPlanId], references: [id])
  homeLocation     Location          @relation(fields: [homeLocationId], references: [id])
  payments         PaymentLog[]
}

model CheckIn {
  id         String      @id @default(uuid())
  userId     String
  locationId String
  timestamp  DateTime    @default(now())
  source     CheckInSource @default(QR)
  user       User        @relation(fields: [userId], references: [id])
  location   Location    @relation(fields: [locationId], references: [id])
}

model ClassType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  classes     Class[]
}

model Class {
  id             String      @id @default(uuid())
  locationId     String
  classTypeId    String?
  name           String
  trainerId      String
  room           String
  capacity       Int
  startTime      DateTime
  endTime        DateTime
  recurrenceRule String?
  isCancelled    Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  location       Location    @relation(fields: [locationId], references: [id])
  classType      ClassType?  @relation(fields: [classTypeId], references: [id])
  trainer        User        @relation(fields: [trainerId], references: [id])
  bookings       ClassBooking[]
}

model ClassBooking {
  id        String        @id @default(uuid())
  classId   String
  userId    String
  status    BookingStatus @default(BOOKED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  class     Class         @relation(fields: [classId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([classId, userId])
}

model TrainerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  bio            String
  certifications Json
  specialties    Json
  rate           Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
  locations      TrainerLocation[]
}

model TrainerLocation {
  id          String    @id @default(uuid())
  trainerId   String
  locationId  String
  createdAt   DateTime  @default(now())
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id])
  location    Location  @relation(fields: [locationId], references: [id])

  @@unique([trainerId, locationId])
}

model TrainerSession {
  id         String               @id @default(uuid())
  trainerId  String
  clientId   String
  locationId String
  startTime  DateTime
  endTime    DateTime
  status     TrainerSessionStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  trainer    User                 @relation("TrainerSessions", fields: [trainerId], references: [id])
  client     User                 @relation("ClientSessions", fields: [clientId], references: [id])
  location   Location             @relation(fields: [locationId], references: [id])
  sessionNotes SessionNote[]
}

model WorkoutPlan {
  id          String   @id @default(uuid())
  trainerId   String
  clientId    String
  title       String
  description String?
  structure   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trainer     User     @relation(fields: [trainerId], references: [id])
  client      User     @relation(fields: [clientId], references: [id])
}

model SessionNote {
  id               String   @id @default(uuid())
  trainerSessionId String
  authorId         String
  note             String
  createdAt        DateTime @default(now())
  session          TrainerSession @relation(fields: [trainerSessionId], references: [id])
  author           User     @relation(fields: [authorId], references: [id])
}

model PaymentLog {
  id               String        @id @default(uuid())
  userId           String
  subscriptionId   String?
  amount           Decimal
  currency         String
  timestamp        DateTime      @default(now())
  paymentMethod    String?
  externalReference String?
  status           PaymentStatus @default(PENDING)
  user             User          @relation(fields: [userId], references: [id])
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorUserId String
  action     String
  targetType String
  targetId   String
  timestamp  DateTime @default(now())
  metadata   Json
  actor      User     @relation("AuditActor", fields: [actorUserId], references: [id])
}
